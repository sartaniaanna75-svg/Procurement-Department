{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: vite (Cursor Node)",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\Programs\\cursor\\resources\\app\\resources\\helpers\\node.exe node_modules/vite/bin/vite.js --port 5173 --host 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
